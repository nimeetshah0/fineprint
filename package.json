{
  "name": "contract-redliner-mcp",
  "version": "0.3.0",
  "description": "Free open-source Contract Redliner MCP App (SEP-1865) with Material 3 UI, native Microsoft Word (.docx) Track Changes + Margin Comments, PDF & Markdown exports",
  "license": "MIT",
  "homepage": "https://fineprint.nimhq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimeetshah0/fineprint.git"
  },
  "type": "module",
  "bin": {
    "contract-redliner-mcp": "dist/server/server.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-apps",
    "sep-1865",
    "contract-review",
    "docx",
    "track-changes",
    "claude",
    "chatgpt",
    "antigravity"
  ],
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "build": "npm run build:server && npm run build:ui",
    "start": "node dist/server/server.js",
    "start:http": "node dist/server/server.js --http",
    "dev:cf": "npm run build:ui && wrangler dev",
    "deploy:cf": "npm run build:ui && wrangler deploy",
    "test:docx": "node test/docx-fidelity.test.mjs && node test/40page-msa.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "jszip": "^3.10.1",
    "unpdf": "^0.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
